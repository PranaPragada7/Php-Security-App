# Docker Compose development settings
DB_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
ROOT_USERNAME=admin

# Generate each secret with:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
AES_KEY=replace-with-64-hexadecimal-characters
HMAC_SECRET_KEY=replace-with-64-hexadecimal-characters
